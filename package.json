{
  "name": "@local/dsh-remote-machine",
  "version": "0.0.1",
  "description": "DSH multi-computer remote execution: explicit computer_id tools for screenshots, managed commands and files on remote machines (P1: SSH transport)",
  "private": true,
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "src/host",
    "src/remote/agent.py"
  ],
  "scripts": {
    "test": "node --test --test-force-exit test/",
    "test:live": "DSH_REMOTE_LIVE=1 node --test --test-force-exit test/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
